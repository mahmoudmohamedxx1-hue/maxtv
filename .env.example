# ─── MaxTV environment ────────────────────────────────────────────────────────
# Every variable is OPTIONAL — the app runs with safe defaults.

# HMAC secret used to sign internal /api/hls source URLs (prevents open-proxy
# abuse of your server). Falls back to a random per-process secret when unset,
# which invalidates signed URLs on every restart — set a fixed value in
# production so failover links and caches survive deploys.
HLS_SIGN_SECRET=

# Port the production standalone server listens on (default 3000).
PORT=3000

# Cloudflare Worker proxy URL — when set, ALL turbo transport upstream
# fetches (m3u8 manifest + segments) are routed through this Worker.
# The DaddyLive CDN edge (edge.cowedd4855ws.sbs) returns 403 for Vercel's
# IP ranges; the Worker runs on Cloudflare's edge (different IP) which is
# NOT blocked. Deploy the Worker using cloudflare-worker.js in this repo.
# Example: https://maxtv-proxy.yourname.workers.dev
CF_PROXY_URL=
