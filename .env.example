# ─── MaxTV environment ────────────────────────────────────────────────────────
# Every variable is OPTIONAL — the app runs with safe defaults.

# HMAC secret used to sign internal /api/hls source URLs (prevents open-proxy
# abuse of your server). Falls back to a random per-process secret when unset,
# which invalidates signed URLs on every restart — set a fixed value in
# production so failover links and caches survive deploys.
HLS_SIGN_SECRET=

# Port the production standalone server listens on (default 3000).
PORT=3000
