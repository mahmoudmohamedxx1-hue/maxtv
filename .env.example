# ─── MaxTV environment ────────────────────────────────────────────────────────
# Every variable is OPTIONAL — the app runs with safe defaults.

# HMAC secret used to sign internal /api/hls source URLs (prevents open-proxy
# abuse of your server). Falls back to a random per-process secret when unset,
# which invalidates signed URLs on every restart — set a fixed value in
# production so failover links and caches survive deploys.
HLS_SIGN_SECRET=

# Port the production standalone server listens on (default 3000).
PORT=3000

# Cloudflare Worker proxy URL — when set, ALL streaming-layer upstream
# fetches (m3u8 manifest + segments + DaddyLive page resolves + channel
# health probes) route through this Worker. The DaddyLive CDN edge
# (edge.cowedd4855ws.sbs) returns 403 for Vercel's serverless (AWS) IPs
# AND for many dev-machine / home-ISP egress IPs; the Worker runs on
# Cloudflare's edge (different IP range) which is NOT blocked.
#
# On Vercel prod you can LEAVE THIS EMPTY — every streaming fetch is
# automatically routed through /api/proxy (runtime=edge), which also
# runs on Cloudflare's edge IPs and bypasses the block. CF_PROXY_URL is
# only needed for SELF-HOSTED deployments or dev machines whose egress
# IP is blocked. Deploy the Worker using cloudflare-worker.js in this
# repo (https://dash.cloudflare.com → Workers & Pages → Create Worker).
# Example: https://maxtv-proxy.yourname.workers.dev
CF_PROXY_URL=

# Override the absolute base URL used when routing streaming fetches
# through the in-repo /api/proxy edge route. Normally this is derived
# automatically from VERCEL_URL (set by Vercel at runtime) — set this
# only when you want the bypass active on a self-hosted standalone
# server (where VERCEL=1 is set manually and there's no VERCEL_URL).
# Must include the scheme + host + port. Examples:
#   PROXY_BASE_URL=http://localhost:3000   # dev / standalone server
#   PROXY_BASE_URL=https://myhost.example.com  # self-hosted prod w/ TLS
PROXY_BASE_URL=

