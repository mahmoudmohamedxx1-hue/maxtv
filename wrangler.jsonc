{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The MaxTV worker — thin API fast-path + OpenNext pages + static assets.
  // Deployed on the Workers FREE plan:
  //   • static assets are served BEFORE the worker (free + unlimited — page
  //     loads never touch the request budget)
  //   • /api/* runs worker/entry.mjs → worker/dist/api.mjs (the thin data
  //     plane: ~1-3ms CPU — the OpenNext/Next.js server could not fit the
  //     free-plan per-invocation CPU budget and 503'd every API route)
  //   • non-API paths fall through to the OpenNext server (pages, RSC)
  //   • 100k requests/day — the player poll cadence + Cache API +
  //     browser-cached segments keep a personal-use household inside it
  //   • 50 subrequests/invocation — the turbo engine budgets itself
  //     (see src/lib/streaming/runtime.ts)
  "name": "maxtv",
  "main": "worker/entry.mjs",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
